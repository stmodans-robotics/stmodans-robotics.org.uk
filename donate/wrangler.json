{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "donate",
    "compatibility_date": "2026-05-01",
    "observability": {
        "enabled": true
    },
    
    "main": "src/worker.js",

    "d1_databases": [
        {
            "binding": "donations",
            "database_name": "donations",
            "database_id": "${d1_donations_UUID}",
            "migrations_dir": "migrations"
        }
    ]
}
